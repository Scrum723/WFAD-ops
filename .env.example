# Copy to .env (repo root) and wfad/.env for `adk web wfad`.
# Prefer Vertex in the deployed service so the video shows a Google Cloud console.

GOOGLE_CLOUD_PROJECT=wfad-506515
GOOGLE_CLOUD_LOCATION=us-central1

# Deployed path (Vertex / Gemini Enterprise).
GOOGLE_GENAI_USE_VERTEXAI=TRUE
# Newer ADK Cloud Run docs also read this flag:
GOOGLE_GENAI_USE_ENTERPRISE=TRUE

# Local fallback if Vertex ADC is not set up yet (Google AI Studio key).
# GOOGLE_GENAI_USE_VERTEXAI=FALSE
# GOOGLE_API_KEY=

# Firestore collection is wfad_runs in named database `wfad` (region nam5).
FIRESTORE_COLLECTION=wfad_runs
FIRESTORE_DATABASE=wfad

# Optional real outbound email (Wednesday). Without these, disseminate is a labeled stub.
WFAD_RECIPIENTS=you@example.com

# Leesa handoff (Story desk approve_package)
WFAD_LEESA_BUNDLES=/Users/charlesclottin/Desktop/Doc Weather Content/bundles
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# WFAD_FROM_EMAIL=
